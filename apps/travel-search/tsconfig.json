{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "travel-core": ["../../packages/travel-core/src"],
      "travel-sdk": ["../../packages/travel-sdk/index.js"],
      "travel-sdk/lib/remote-registry.dev.json": [
        "../../packages/travel-sdk/lib/remote-registry.dev.json"
      ],
      "travel-sdk/lib/remote-registry.prod.json": [
        "../../packages/travel-sdk/lib/remote-registry.prod.json"
      ],
      "travel-sdk/lib/manifestCacheKeys.js": [
        "../../packages/travel-sdk/lib/manifestCacheKeys.js"
      ]
    }
  },
  "include": ["src/**/*", "index.js", "rspack.config.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
