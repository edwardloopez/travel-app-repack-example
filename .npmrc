# npm / pnpm security best practices
# https://github.com/lirantal/npm-security-best-practices

# SECURITY: do not run lifecycle scripts (postinstall, etc.) unless allow-listed in pnpm-workspace.yaml
ignore-scripts=true

# SECURITY: reject git-source dependencies (git+ssh://, git+https://, etc.)
allow-git=none

# SECURITY: block package versions published in the last 7 days (cooldown against supply-chain attacks)
min-release-age=7
