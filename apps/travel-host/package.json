{
  "name": "TravelHost",
  "version": "0.0.1",
  "private": true,
  "travel:dependencies": {
    "TravelWeather": "workspace:*",
    "TravelDestinations": "workspace:*",
    "TravelSearch": "workspace:*",
    "TravelPhotos": "workspace:*"
  },
  "scripts": {
    "android": "ENFILE=.env rnef run:android",
    "ios": "ENFILE=.env rnef run:ios",
    "start": "rnef start",
    "test": "nx jest:test --passWithNoTests",
    "lint": "nx eslint:lint --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc",
    "bundle:ios": "rnef bundle --platform ios --entry-file index.ts --dev false",
    "bundle:android": "rnef bundle --platform android --entry-file index.ts --dev false",
    "adbreverse": "adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@module-federation/enhanced": "0.13.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "expo": "~53.0.20",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-config": "^1.5.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "travel-core": "workspace:*"
  },
  "dependenciesMeta": {
    "travel-core": {
      "injected": true
    }
  },
  "devDependencies": {
    "@callstack/repack": "5.1.1",
    "@callstack/repack-plugin-expo-modules": "^5.1.3",
    "@react-native/eslint-config": "0.79.4",
    "@react-native/typescript-config": "0.79.4",
    "@rnef/cli": "^0.7.5",
    "@rnef/platform-android": "^0.7.5",
    "@rnef/platform-ios": "^0.7.5",
    "@rnef/plugin-repack": "^0.7.5",
    "@rspack/core": "^1.2.2",
    "@swc/helpers": "0.5.15",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "dotenv": "^17.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.6.3",
    "travel-sdk": "workspace:*",
    "typescript": "~5.8.3",
    "zephyr-repack-plugin": "0.0.54"
  },
  "devDependenciesMeta": {
    "travel-sdk": {
      "injected": true
    }
  }
}
