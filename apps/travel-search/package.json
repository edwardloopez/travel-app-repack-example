{
  "name": "TravelSearch",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android --port 9002",
    "ios": "react-native run-ios --port 9002",
    "start": "react-native start --port 9002",
    "start:standalone": "react-native start --port 9002",
    "test": "nx jest:test --passWithNoTests",
    "lint": "nx eslint:lint --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc",
    "bundle:ios": "react-native bundle --platform ios --entry-file index.js --dev false",
    "bundle:android": "react-native bundle --platform android --entry-file index.js --dev false",
    "bundle:remote:ios": "react-native webpack-bundle --platform ios --dev false --entry-file index.js",
    "bundle:remote:android": "react-native webpack-bundle --platform android --dev false --entry-file index.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@module-federation/enhanced": "0.13.1",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-config": "^1.5.6",
    "react-native-paper": "^5.12.5",
    "react-native-safe-area-context": "5.4.0",
    "travel-core": "workspace:*"
  },
  "dependenciesMeta": {
    "travel-core": {
      "injected": true
    }
  },
  "devDependencies": {
    "@callstack/repack": "5.2.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@rspack/core": "^1.2.2",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.12",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.0",
    "jest": "^29.6.3",
    "travel-sdk": "workspace:*",
    "typescript": "~5.8.3"
  },
  "devDependenciesMeta": {
    "travel-sdk": {
      "injected": true
    }
  }
}
