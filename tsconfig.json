{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Monorepo base (shared defaults for IDE and tooling)",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-native",
    "lib": [
      "es2019",
      "es2020.promise",
      "es2021.promise",
      "es2022.array",
      "es2022.object",
      "es2022.string"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "**/Pods/**", "remotes-dist"]
}
