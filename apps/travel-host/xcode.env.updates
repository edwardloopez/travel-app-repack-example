# Source of truth for ios/.xcode.env.updates (applied on `expo prebuild` via withRepackXcodeBundle).
# Override Expo defaults (export:embed + @expo/cli) so release builds use Re.Pack.
export BUNDLE_COMMAND="webpack-bundle"
export CLI_PATH="$("$NODE_BINARY" --print "require('path').dirname(require.resolve('@react-native-community/cli/package.json')) + '/build/bin.js'")"

if [[ "$CONFIGURATION" != *Debug* ]]; then
  export NODE_ENV=production
fi
