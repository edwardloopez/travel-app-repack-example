# Module Federation profile: dev | static | external
# After changing, restart the host dev server (native rebuild only if Config is empty in logs).
REMOTE_PROFILE=dev

# Optional — only needed for dev profile on a physical device (simulator uses localhost).
# HOST_IP_ADDRESS=192.168.1.100

# Optional — Weather micro-app API key (not MF infrastructure).
OPENWEATHER_API_KEY=your_openweather_api_key_here
