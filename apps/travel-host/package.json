{
  "name": "TravelHost",
  "version": "0.0.1",
  "private": true,
  "travel:dependencies": {
    "TravelWeather": "workspace:*",
    "TravelDestinations": "workspace:*",
    "TravelSearch": "workspace:*",
    "TravelPhotos": "workspace:*"
  },
  "scripts": {
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --device --no-bundler",
    "start": "react-native start",
    "test": "nx jest:test --passWithNoTests",
    "lint": "nx eslint:lint --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc",
    "bundle:ios": "react-native bundle --platform ios --entry-file index.ts --dev false",
    "bundle:android": "react-native bundle --platform android --entry-file index.ts --dev false",
    "adbreverse": "adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@module-federation/enhanced": "0.13.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "expo": "~53.0.22",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-config": "^1.5.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.12.0",
    "travel-core": "workspace:*"
  },
  "dependenciesMeta": {
    "travel-core": {
      "injected": true
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-flow": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@callstack/repack": "5.2.0",
    "@callstack/repack-plugin-expo-modules": "^5.2.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@rspack/core": "^1.4.0",
    "@swc/helpers": "0.5.15",
    "@types/jest": "^29.5.14",
    "@types/react": "19.1.12",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv": "^17.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.6.3",
    "travel-sdk": "workspace:*",
    "typescript": "~5.8.3",
    "zephyr-repack-plugin": "0.0.54"
  },
  "devDependenciesMeta": {
    "travel-sdk": {
      "injected": true
    }
  }
}
