# Remote profile: dev | static | external
# Used by react-native-config (runtime) and rspack (build-time remotes).
# After changing this file, restart the host dev server (native rebuild only if Config is empty in logs).
HOST_IP_ADDRESS=localhost
REMOTE_PROFILE=dev
REMOTE_STATIC_BASE_URL=http://localhost:4100
REMOTE_REGISTRY_URL=http://localhost:4100/remote-registry.json
OPENWEATHER_API_KEY=your_openweather_api_key_here
