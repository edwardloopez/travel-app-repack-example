{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "paths": {
      "travel-sdk/lib/remotesCatalog.json": [
        "../travel-sdk/lib/remotesCatalog.json"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
